{
  "models": [
    {
      "name": "ProductListing",
      "description": "A component designed to display a list of products fetched from an external API.",
      "fields": [
        {
          "fieldId": "productListingData",
          "type": "structured-content",
          "label": "Product Listing Configuration",
          "required": true,
          "description": "Allows content authors to configure the product listing, potentially overriding the hardcoded API endpoint or selecting which fields (e.g., title, price) are displayed by the ProductCard component."
        },
        {
          "fieldId": "productFilterSettings",
          "type": "select-dropdown",
          "label": "Filtering/Sorting Criteria",
          "required": false,
          "description": "If the listing needs to support filtering or sorting, this field would allow authors to select criteria (e.g., 'Brand', 'Price Range')."
        }
      ]
    }
  ],
  "definitions": {
    "structured-content": {
      "type": "StructuredContent",
      "description": "A flexible container for complex product listing settings.",
      "fields": [
        {
          "fieldId": "apiEndpoint",
          "type": "text",
          "label": "API Endpoint URL",
          "placeholder": "https://api.example.com/products"
        },
        {
          "fieldId": "displayFields",
          "type": "checkbox-group",
          "label": "Visible Product Fields",
          "options": [
            {
              "value": "title",
              "label": "Title"
            },
            {
              "value": "price",
              "label": "Price"
            },
            {
              "value": "sku",
              "label": "SKU"
            }
          ]
        },
        {
          "fieldId": "sortOrder",
          "type": "select-dropdown",
          "label": "Default Sort Order",
          "options": [
            {
              "value": "relevance",
              "label": "Relevance"
            },
            {
              "value": "price_asc",
              "label": "Price (Low to High)"
            },
            {
              "value": "newest",
              "label": "Newest First"
            }
          ]
        }
      ]
    }
  },
  "filters": [
    {
      "fieldId": "productListingData",
      "type": "structured-content",
      "description": "Used for the authorable configuration of product listing data."
    },
    {
      "fieldId": "productFilterSettings",
      "type": "select-dropdown",
      "description": "Used for selecting filtering criteria."
    }
  ]
}